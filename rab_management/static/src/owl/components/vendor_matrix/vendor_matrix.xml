<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="rab_management.VendorMatrix">

    <t t-if="state.loading">
        <div class="p-3 text-muted">Loading...</div>
    </t>

    <t t-else="">
        <table class="table table-bordered table-sm align-middle">
            <thead>
                <tr>
                    <th>Item</th>
                    <th class="text-center">Qty</th>
                    <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                        <th colspan="3" class="text-center">
                            <t t-esc="vendor.name"/>
                        </th>
                    </t>
                </tr>
                <tr>
                    <th/>
                    <th/>
                    <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">
                        <th class="text-center">Awal</th>
                        <th class="text-center">Nego</th>
                        <th/>
                    </t>
                </tr>
            </thead>

            <tbody>
                <t t-foreach="state.items" t-as="item" t-key="item.id">
                    <tr>
                        <td>
                            <t t-esc="item.name"/>
                        </td>

                        <td class="text-center">
                            <t t-esc="item.qty"/>
                        </td>

                        <t t-foreach="state.vendors" t-as="vendor" t-key="vendor.id">

                            <t t-set="priceLine" t-value="item.prices[vendor.id]"/>

                            <!-- Harga Awal -->
                            <td class="text-end">
                                <t t-if="priceLine">
                                    <t t-esc="formatPrice(priceLine.base)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>

                            <!-- Harga Nego -->
                            <td class="text-end">
                                <t t-if="priceLine">
                                    <t t-esc="formatPrice(priceLine.nego)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>

                            <!-- Action -->
                            <td class="text-center">

                                <!-- DRAFT → NEGOTIATION -->
                                <button
                                    t-if="priceLine and priceLine.vendor_state == 'draft'"
                                    class="btn btn-sm btn-outline-primary"
                                    t-on-click="onSetNegotiation"
                                    t-att-data-id="priceLine.id">
                                    Mulai Nego
                                </button>

                                <!-- NEGOTIATION → FINAL -->
                                <button
                                    t-if="priceLine and priceLine.vendor_state == 'negotiation'"
                                    class="btn btn-sm btn-success"
                                    t-on-click="onSelectVendor"
                                    t-att-data-id="priceLine.id">
                                    Pilih
                                </button>

                                <!-- FINAL -->
                                <span
                                    t-if="priceLine and priceLine.vendor_state == 'final'"
                                    class="badge bg-success">
                                    Final
                                </span>

                            </td>

                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>

</t>

</templates>
