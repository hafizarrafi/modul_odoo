<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rab_vendor_comparison_tree" model="ir.ui.view">
        <field name="name">rab.vendor.comparison.tree</field>
        <field name="model">rab.vendor.comparison</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="vendor_id"/>
                <field name="price"/>

                <field name="last_purchase_price"
                       readonly="1"
                       class="text-muted"/>

                <field name="last_purchase_date"
                       widget="date"
                       readonly="1"
                       class="text-muted"/>
                       
                <!-- PILIH -->
                <button name="action_select_vendor"
                        type="object"
                        string="Select"
                        class="btn-secondary"
                        invisible="is_selected"/>

                <button name="action_select_vendor"
                        type="object"
                        string="Selected"
                        class="btn-success"
                        readonly="1"
                        invisible="not is_selected"/>

            </list>
        </field>
    </record>

</odoo>
