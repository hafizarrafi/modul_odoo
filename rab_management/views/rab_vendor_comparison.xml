<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rab_vendor_comparison_tree" model="ir.ui.view">
        <field name="name">rab.vendor.comparison.tree</field>
        <field name="model">rab.vendor.comparison</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="vendor_id"/>
                <field name="price"/>
                <field name="is_selected" readonly="1"/>

                <button name="action_select_vendor"
                        type="object"
                        string="Select"
                        class="oe_highlight"
                        invisible="is_selected"/>
            </list>
        </field>
    </record>
</odoo>
