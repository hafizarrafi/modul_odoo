<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_rab_vendor_comparison_pivot" model="ir.ui.view">
        <field name="name">rab.vendor.comparison.pivot</field>
        <field name="model">rab.vendor.comparison</field>
        <field name="arch" type="xml">
            <pivot string="Vendor Comparison Matrix">
                <field name="product_id" type="row"/>
                <field name="vendor_id" type="col"/>
                <field name="price" type="measure"/>
            </pivot>
        </field>
    </record>
        <record id="action_rab_vendor_comparison_pivot" model="ir.actions.act_window">
        <field name="name">Vendor Matrix</field>
        <field name="res_model">rab.vendor.comparison</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_rab_vendor_comparison_pivot"/>
        <field name="context">
            {
                "search_default_groupby_product_id": 1,
                "search_default_groupby_vendor_id": 1
            }
        </field>
    </record>

</odoo>
